	)
	(text "Charger: BQ25155. VBATREG per cell datasheet. TS pin + NTC closes F11."
		(exclude_from_sim no)
		(at 20 34 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "2f82f100-8b0c-41c5-bbd9-566cede5545b")
	)
	(text "LDO: TPS7A0230 fixed 3.0 V, fed from BQ25155 PMID, not the cell (B4.5)."
		(exclude_from_sim no)
		(at 20 38 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "601a45dc-eed0-4759-8b55-22bdc0dbfdb2")
	)
	(text "Protection: BQ29700 + dual N-FET. OCD 0.100 V / SCD 0.5 V ACROSS THE FETs."
		(exclude_from_sim no)
		(at 20 42 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "e1103c87-53f7-44ed-be96-f5265542a77e")
	)
	(text "  At 50 mOhm that is 2 A / 10 A: a short-circuit protector, NOT overcurrent (B8.2)."
